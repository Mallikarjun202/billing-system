# Copy this file to .env and fill in what you need. Never commit .env.

APP_NAME=Billing System
CURRENCY_SYMBOL=₹
# DATABASE_URL=sqlite:///data/billing.db
# SQL_ECHO=false

# --- Invoice email (optional) ---
# Leave SMTP_PASSWORD empty and invoices are saved to data/sent_emails/ instead.
# For Gmail: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste it below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_SSL=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
